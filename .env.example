GEMINI_API_KEY=
API_TOKEN=
GEMINI_API_MODEL=gemini-3.7-flash
GEMINI_API_VERSION=v1beta
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash
GEMINI_API_REVISION=2026-05-20
# Each Gemini request is capped, and so is the whole retry and fallback chain.
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_TOTAL_TIMEOUT_SECONDS=60

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=price_predict
POSTGRES_PORT=5432
API_PORT=8000

# Percent-encode reserved characters in the password. @ is %40.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/price_predict
DATABASE_URL_DOCKER=postgresql://postgres:PASSWORD@db:5432/price_predict

DB_POOL_MIN=1
DB_POOL_MAX=5
MAX_UPLOAD_BYTES=2000000
MAX_MESSAGE_CHARS=20000
